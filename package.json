{
  "name": "sweety-root",
  "version": "1.0.0",
  "description": "Sweety - Blood Glucose Tracker (MERN + PostgreSQL)",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
